# Copia este fichero a .env (está en .gitignore).
# Un solo fichero para los dos lados del proyecto.

# ---------------------------------------------------------------------------
# Frontend (Vite solo expone al navegador las variables con prefijo VITE_)
# ---------------------------------------------------------------------------

# Vacío o sin definir => el frontend usa su mock en memoria y funciona solo.
# /api => habla con la API. Vale tanto en local (Vite hace de proxy hacia
#         localhost:3000) como desplegado (CloudFront enruta /api/* hacia
#         API Gateway). En los dos casos se quita el prefijo antes de llegar.
VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
# Backend (estas NO llegan al navegador; en AWS van como variables de entorno
# de cada Lambda, y el secreto desde Secrets Manager o SSM)
# ---------------------------------------------------------------------------

SESSION_SECRET=cambia-esto
SESSION_HOURS=12
MAGIC_LINK_MINUTES=15

# Modo taller: devuelve el token del enlace en la respuesta en vez de
# enviarlo por correo, para no depender de SES en sandbox. Nunca en producción.
RETURN_MAGIC_LINK_TOKEN=true

# Correo (SES). Vacío = no se envía nada y hace falta el token de arriba.
# El remitente tiene que estar verificado en SES, en la misma región.
MAIL_FROM=
# Base pública del sitio: de aquí sale el enlace que va en el correo.
APP_URL=http://localhost:5173

# memory | dynamodb  (dynamodb aún no existe: falta diseñar el modelo)
REPOSITORY=memory

# ---------------------------------------------------------------------------
# Reglas del juego. El backend manda; el frontend usa las suyas solo para
# pintar antes de que conteste el servidor.
# ---------------------------------------------------------------------------

SECONDS_PER_QUESTION=20
SPEED_BONUS_MAX=80
VITE_SECONDS_PER_QUESTION=20
VITE_SPEED_BONUS_MAX=80
