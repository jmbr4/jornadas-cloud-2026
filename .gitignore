# Variables de entorno locales.
#
# `.env*` y no `.env`: el patrón suelto matchea solo ese nombre exacto, y
# `frontend/src/config.ts` da por hecho que puede existir un `.env.production`.
# La excepción va DESPUÉS de la regla, que es el único orden en que git la
# tiene en cuenta.
.env*
!.env.example
.vite

